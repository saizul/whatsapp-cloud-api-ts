{
  "name": "whatsapp-cloud-api-ts",
  "version": "0.1.0",
  "description": "Typed, zero-dependency client for the Meta WhatsApp Business Cloud API with webhook helpers.",
  "keywords": ["whatsapp", "whatsapp-cloud-api", "meta", "graph-api", "webhook", "typescript", "chatbot"],
  "author": "Saizul Amin <https://saizul.com>",
  "license": "MIT",
  "homepage": "https://github.com/saizul/whatsapp-cloud-api-ts#readme",
  "repository": { "type": "git", "url": "git+https://github.com/saizul/whatsapp-cloud-api-ts.git" },
  "bugs": { "url": "https://github.com/saizul/whatsapp-cloud-api-ts/issues" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "example": "npm run build && node examples/server.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
